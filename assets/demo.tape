# Where should we write the GIF?
Output assets/demo.gif

# Set up a 800x600 terminal with 20px font.
Set FontSize 20
Set Width 800
Set Height 600

# Type a command in the terminal.
Set Shell zsh
Sleep 1.5s
Type "uv run tictactoe"
Sleep 1.5s
Enter
Sleep 3s
Type "x"
Sleep 1.5s
Enter
Sleep 1.5s
Type "1"
Sleep 1.5s
Enter
Sleep 1.5s
Type "5"
Sleep 1.5s
Enter
Sleep 1.5s
Type "9"
Sleep 1.5s
Enter
Sleep 1.5s

# Pause for dramatic effect...
Sleep 50ms

# Run the command by pressing enter.
Enter

# Admire the output for a bit.
Sleep 2s
